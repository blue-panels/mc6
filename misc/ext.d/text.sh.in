#!/bin/sh

# $1 - action
# $2 - type of archive
# $3 - pager

action=$1
filetype=$2
pager=$3

[ -n "${MC_XDG_OPEN}" ] || MC_XDG_OPEN="xdg-open"

get_unpacker() {
    filetype=$1
    case "${filetype}" in
    man.gz)
        unpacker="gzip -dc"
        ;;
    man.bz)
        unpacker="bzip -dc"
        ;;
    man.bz2)
        unpacker="bzip2 -dc"
        ;;
    man.lz)
        unpacker="lzip -dc"
        ;;
    man.lz4)
        unpacker="lz4 -dc"
        ;;
    man.lzma)
        unpacker="lzma -dc"
        ;;
    man.lzo)
        unpacker="lzop -dc"
        ;;
    man.xz)
        unpacker="xz -dc"
        ;;
    man.zst)
        unpacker="zstd -dc"
        ;;
    esac
    echo ${unpacker}
}

# $1 - macro package; $2 - the file, standard input without it
# With preconv and a UTF-8 capable nroff the text is read in the charset of
# the locale and written as UTF-8, converted back by iconv for an 8-bit
# locale.  Otherwise nroff passes the bytes of the text through.
do_nroff() {
    macros=$1
    shift
    charset=`locale charmap 2>/dev/null`
    if [ -n "@NROFF_UTF8@" ] && [ "${charset}" = "UTF-8" ]; then
        preconv "$@" 2>/dev/null | nroff @MAN_FLAGS@ @NROFF_UTF8@ ${macros} 2>/dev/null
    elif [ -n "@NROFF_UTF8@" ] && [ -n "${charset}" ] && command -v iconv >/dev/null 2>&1; then
        preconv "$@" 2>/dev/null | nroff @MAN_FLAGS@ @NROFF_UTF8@ ${macros} 2>/dev/null \
            | iconv -f UTF-8 -t "${charset}//TRANSLIT" 2>/dev/null
    else
        nroff @MAN_FLAGS@ @NROFF_8BIT@ ${macros} "$@" 2>/dev/null
    fi
}

do_view_action() {
    filetype=$1

    unpacker=`get_unpacker ${filetype}`

    case "${filetype}" in
    man)
        case "${MC_EXT_FILENAME}" in
        */log/*|*/logs/*)
            cat "${MC_EXT_FILENAME}"
            ;;
        *)
            MANROFFOPT=-c MAN_KEEP_FORMATTING=1 man -P cat "${MC_EXT_FILENAME}" 2>/dev/null
            ;;
        esac
        ;;
    pod)
        pod2man "${MC_EXT_FILENAME}" 2>/dev/null | do_nroff @MANDOC@
        ;;
    nroff.me)
        do_nroff -me "${MC_EXT_FILENAME}"
        ;;
    nroff.ms)
        do_nroff -ms "${MC_EXT_FILENAME}"
        ;;
    man.gz|man.bz|man.bz2|man.lz|man.lz4|man.lzma|man.lzo|man.xz|man.zst)
        case "${MC_EXT_FILENAME}" in
        */log/*|*/logs/*)
            ${unpacker} "${MC_EXT_FILENAME}"
            ;;
        *)
            # "man" takes care of uncompressing.
            # This way the stdin is left intact so the correct width is used.
            MANROFFOPT=-c MAN_KEEP_FORMATTING=1 man -P cat "${MC_EXT_FILENAME}" 2>/dev/null
            ;;
        esac
        ;;
    *)
        ;;
    esac
}

do_open_action() {
    filetype=$1
    pager=$2

    unpacker=`get_unpacker ${filetype}`

    case "${filetype}" in
    info)
        info -f "${MC_EXT_FILENAME}"
        ;;
    man)
        case "${MC_EXT_FILENAME}" in
        */log/*|*/logs/*)
            cat "${MC_EXT_FILENAME}"
            ;;
        *)
            { zsoelim "${MC_EXT_FILENAME}" 2>/dev/null || cat "${MC_EXT_FILENAME}"; } | \
                do_nroff @MANDOC@
            ;;
        esac | ${pager}
        ;;
    pod)
        pod2man "${MC_EXT_FILENAME}" 2>/dev/null | do_nroff @MANDOC@ | ${pager}
        ;;
    nroff.me)
        do_nroff -me "${MC_EXT_FILENAME}" | ${pager}
        ;;
    nroff.ms)
        do_nroff -ms "${MC_EXT_FILENAME}" | ${pager}
        ;;
    man.gz|man.bz|man.bz2|man.lz|man.lz4|man.lzma|man.lzo|man.xz|man.zst)
        case "${MC_EXT_FILENAME}" in
        */log/*|*/logs/*)
            ${unpacker} "${MC_EXT_FILENAME}"
            ;;
        *)
            ${unpacker} "${MC_EXT_FILENAME}" | do_nroff @MANDOC@
            ;;
        esac | ${pager}
        ;;
    chm)
        if [ -n "$DISPLAY" ]; then
            command -v kchmviewer >/dev/null 2>&1 \
                && (kchmviewer "${MC_EXT_FILENAME}" &) \
                || (xchm "${MC_EXT_FILENAME}" &)
        else
            chm_http "${MC_EXT_FILENAME}" & elinks http://localhost:8080/index.html
            kill -INT %1
        fi
        ;;
    *)
        ;;
    esac
}

case "${action}" in
view)
    do_view_action "${filetype}"
    ;;
open)
    ("${MC_XDG_OPEN}" "${MC_EXT_FILENAME}" >/dev/null 2>&1) || \
        do_open_action "${filetype}" "${pager}"
    ;;
*)
    ;;
esac
