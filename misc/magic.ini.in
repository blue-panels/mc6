# Plugin file-operation associations.
#
# This file is an overlay for plugin actions. It never replaces mc.ext.ini:
# when no rule here matches, Midnight Commander follows its normal extension
# and panel-plugin handling.
#
# A user may add rules in ~/.config/mc6/magic.ini. Native values use
# %plugin{plugin-id:operation}; runtime packages use
# %plugin{runtime-id(package-id):operation}, for example:
#
# [archive]
# Regex=\\.(tar|tar\\.gz|tgz|zip|7z)$
# Open=%plugin{arcmc:open}

@MAGIC_ARCMC_RULES@

@MAGIC_SQLITE_RULES@

# mcstruct: the group name is the def-file hint (mcstruct-NAME -> NAME.stl)
[mcstruct-uimage]
Type=^u-boot legacy uImage
View=%plugin{mcstruct:show}

[mcstruct-dtb]
Type=^Device Tree Blob
View=%plugin{mcstruct:show}

[mcstruct-mbr]
Type=^DOS/MBR boot sector
View=%plugin{mcstruct:show}

@MAGIC_LUA_CHAFA_RULES@

@MAGIC_LUA_JAVA_CLASS_RULES@

@MAGIC_LUA_READELF_RULES@

@MAGIC_LUA_DBF_RULES@
