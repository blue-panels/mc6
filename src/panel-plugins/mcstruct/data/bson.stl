STL 5.00
;
;   BSON document: the elements of the top level (embedded documents and
;   arrays are shown as blocks). After kaitai_struct_formats
;   serialization/bson.ksy.
;

/BSON
dsz:    i32     1               document size
#set    dend = ^@ - 4 + dsz
#repeat while ^@ < dend - 1
        :--- element ---
et:     u8      'bson_type      type
        sc      0               name
#if et == 1
        f64     1               double
#elseif et == 2 || et == 13 || et == 14
sl:     i32     1               string length
        c       sl              string (with NUL)
#elseif et == 3 || et == 4
bl:     i32     1               document size
        +       "bl - 4"        document
#elseif et == 5
bl:     i32     1               binary length
        u8      'bson_subtype   subtype
        +       bl              binary
#elseif et == 7
        b       12              ObjectId
#elseif et == 8
        u8      1               boolean
#elseif et == 9
        i64     1               UTC datetime, ms
#elseif et == 11
        sc      0               regex pattern
        sc      0               regex options
#elseif et == 16
        i32     1               int32
#elseif et == 17
        u64     1               timestamp
#elseif et == 18
        i64     1               int64
#elseif et == 19
        b       16              decimal128
#fi
#end
        u8      1               end of document

/'bson_type
1       double
2       string
3       document
4       array
5       binary
6       undefined
7       ObjectId
8       boolean
9       UTC datetime
10      null
11      regex
12      DBPointer
13      JavaScript
14      symbol
15      JavaScript with scope
16      int32
17      timestamp
18      int64
19      decimal128
255     min key
127     max key

/'bson_subtype
0       generic
1       function
2       binary (old)
3       UUID (old)
4       UUID
5       MD5
6       encrypted
128     user defined
