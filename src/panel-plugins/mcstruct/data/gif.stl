STL 5.00
;
;   GIF 87a/89a: header, screen descriptor, global color table and the
;   block stream up to the trailer. After kaitai_struct_formats image/gif.ksy.
;

/GIF
#if (@d & 0xFFFFFF) != 'GIF'
        :ERROR!!! no GIF signature at this offset
#fi
        c       3               signature
        c       3               version
        u16     1               screen width
        u16     1               screen height
flags:  t8      `gif_screen     flags
        u8      1               background color index
        u8      1               pixel aspect ratio
#if flags & 0x80
#set    ncolors = 2 << (flags & 7)
        *       ncolors :gif_color
#fi
#repeat while ^@ < $size && @b != 0x3B
btype:  u8      'gif_block      block type
#switch btype
#case 0x21
label:  u8      'gif_ext        extension label
#if label == 0xF9
        :--- graphic control ---
        u8      1               block size
        t8      `gif_gce        flags
        u16     1               delay time
        u8      1               transparent color index
        u8      1               terminator
#elseif label == 0xFF
        :--- application ---
        u8      1               block size
        c       8               application identifier
        c       3               authentication code
#repeat while @b != 0
blen:   u8      1               sub-block length
        +       blen
#end
        u8      1               terminator
#else
        :--- comment / plain text / unknown ---
#repeat while @b != 0
blen:   u8      1               sub-block length
        +       blen
#end
        u8      1               terminator
#fi
#case 0x2C
        :--- image descriptor ---
        u16     1               left
        u16     1               top
        u16     1               width
        u16     1               height
iflags: t8      `gif_image      flags
#if iflags & 0x80
#set    lcolors = 2 << (iflags & 7)
        *       lcolors :gif_color
#fi
        u8      1               lzw minimum code size
#repeat while @b != 0
blen:   u8      1               sub-block length
        +       blen
#end
        u8      1               terminator
#default
        :ERROR!!! unknown block type
#end
#end
        u8      'gif_block      trailer

/:gif_color
        u8      red
        u8      green
        u8      blue

/'gif_block
0x21    extension
0x2C    image descriptor
0x3B    trailer

/'gif_ext
0xF9    graphic control
0xFE    comment
0xFF    application
0x01    plain text

/`gif_screen
0x80            global color table
0x70    0x70    color resolution 8 bits
0x08            sorted
0x07    0x07    table size 256
0x07    0x06    table size 128
0x07    0x05    table size 64
0x07    0x04    table size 32
0x07    0x03    table size 16
0x07    0x02    table size 8
0x07    0x01    table size 4
0x07    0x00    table size 2

/`gif_image
0x80            local color table
0x40            interlaced
0x20            sorted

/`gif_gce
0x01            transparent color
0x02            user input
0x1C    0x04    disposal: do not dispose
0x1C    0x08    disposal: restore background
0x1C    0x0C    disposal: restore previous
