STL 5.00
;
;   Windows shell item list (ID list of a .lnk or jump list): items up to
;   the zero terminator. After kaitai_struct_formats
;   windows/windows_shell_items.ksy.
;

/SHELL_ITEMS
#repeat while ^@ + 2 <= $size && @w != 0
        :--- item ---
ilen:   u16     1               item length
#set    iend = ^@ - 2 + ilen
code:   u8      'shi_code       class type
#if code == 0x1F
        u8      1               sort index
        b       16              shell folder guid
#elseif (code & 0x70) == 0x20
        t8      `shi_volume     volume flags
#elseif (code & 0x70) == 0x30
        u8      1               unknown
        u32     1               file size
        td      1               modified
        t16     `shi_attr       attributes
        sc      "iend - ^@"     name
#fi
        +       "iend - ^@"
#end
        u16     1               terminator

/'shi_code
0x1F    root folder
0x20    0x2F    volume
0x30    0x3F    file entry
0x40    0x4F    network location
0x61    URI
0x71    control panel

/`shi_volume
0x01            has name
0x02            removable

/`shi_attr
0x0001          read only
0x0002          hidden
0x0004          system
0x0010          directory
0x0020          archive
0x0080          normal
0x0400          reparse point
0x0800          compressed
