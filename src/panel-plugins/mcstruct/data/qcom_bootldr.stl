STL 5.00
;
;   Qualcomm Android bootloader package (BOOTLDR!): image headers, the
;   bodies follow each other from the body offset.
;   After kaitai_struct_formats archive/android_bootldr_qcom.ksy.
;

/QCOM_BOOTLDR
#if @d != 'BOOT'
        :ERROR!!! no BOOTLDR! signature at this offset
#fi
        c       8               magic
n:      u32     1               images
        u32     1               image bodies offset
        u32     1               bootloader size
        *       n       _QCOM_img

/_QCOM_img
        sc      64              name
        u32     1               body length
