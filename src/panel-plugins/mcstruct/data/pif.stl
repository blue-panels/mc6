STL 5.00
;
;   PIF (Portable Image Format) headers and color table.
;   After kaitai_struct_formats image/pif.ksy (LGPL-2.1).
;

/PIF
#if @d != 'PIF'
        :ERROR!!! no PIF signature at this offset
#fi
        c       4               magic
        u32     1               file length
        u32     1               image data offset
itype:  u16     'pif_type       image type
        u16     1               bits per pixel
        u16     1               width
        u16     1               height
        u32     1               image data length
ctl:    u16     1               color table length
        u16     'pif_comp       compression
#if ctl > 0
        b       ctl             color table
#fi

/'pif_type
0x433C  RGB888
0xE5C5  RGB565
0x1E53  RGB332
0xB895  RGB16C
0x7DAA  black and white
0x4952  indexed RGB888
0x4947  indexed RGB565
0x4942  indexed RGB332

/'pif_comp
0       none
0x7DDE  RLE
