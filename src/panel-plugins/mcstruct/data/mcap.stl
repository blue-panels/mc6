STL 5.00
;
;   MCAP container: records (header, schema, channel, message, chunk,
;   indexes, statistics, footer) with the top-level fields of each.
;   After kaitai_struct_formats log/mcap.ksy (Apache-2.0).
;

/MCAP
#if @d != 0x41434D89
        :ERROR!!! no MCAP magic at this offset
#fi
        b       8               magic
#repeat while ^@ + 9 <= $size && @b != 0x89
        :--- record ---
op:     u8      'mcap_op        opcode
rlen:   u64     1               length
#set    rend = ^@ + rlen
#switch op
#case 1
pl:     u32     1               profile length
        c       pl              profile
ll:     u32     1               library length
        c       ll              library
#case 2
        u64     1               summary start
        u64     1               summary offset start
        d       1               summary crc
#case 3
        u16     1               schema id
nl:     u32     1               name length
        c       nl              name
el:     u32     1               encoding length
        c       el              encoding
dl:     u32     1               data length
        +       dl              data
#case 4
        u16     1               channel id
        u16     1               schema id
tl:     u32     1               topic length
        c       tl              topic
el:     u32     1               message encoding length
        c       el              message encoding
        u32     1               metadata length
#case 5
        u16     1               channel id
        u32     1               sequence
        u64     1               log time, ns
        u64     1               publish time, ns
#case 6
        u64     1               message start time
        u64     1               message end time
        u64     1               uncompressed size
        d       1               uncompressed crc
cl:     u32     1               compression length
        c       cl              compression
        u64     1               records length
#case 7
        u16     1               channel id
        u32     1               records length
#case 8
        u64     1               message start time
        u64     1               message end time
        u64     1               chunk start offset
        u64     1               chunk length
        u32     1               message index offsets length
#case 9
        u64     1               log time
        u64     1               create time
nl:     u32     1               name length
        c       nl              name
ml:     u32     1               media type length
        c       ml              media type
        u64     1               data length
#case 11
        u64     1               messages
        u16     1               schemas
        u32     1               channels
        u32     1               attachments
        u32     1               metadata records
        u32     1               chunks
        u64     1               message start time
        u64     1               message end time
#case 12
nl:     u32     1               name length
        c       nl              name
#case 14
        u8      'mcap_op        group opcode
        u64     1               group start
        u64     1               group length
#case 15
        d       1               data section crc
#end
        +       "rend - ^@"
#end
#if ^@ + 8 <= $size
        b       8               magic
#fi

/'mcap_op
1       header
2       footer
3       schema
4       channel
5       message
6       chunk
7       message index
8       chunk index
9       attachment
10      attachment index
11      statistics
12      metadata
13      metadata index
14      summary offset
15      data end
