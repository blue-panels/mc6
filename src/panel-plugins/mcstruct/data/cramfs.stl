STL 5.00
;
;   cramfs superblock, the root inode and the entries of the root
;   directory. After kaitai_struct_formats filesystem/cramfs.ksy.
;

/CRAMFS
#if @d != 0x28CD3D45
        :ERROR!!! no cramfs signature at this offset
#fi
        d       1               magic
        u32     1               size
        t32     `cramfs_flags   flags
        u32     1               future
        c       16              signature
        d       1               fsid crc
        u32     1               fsid edition
        u32     1               blocks
        u32     1               files
        c       16              name
        :--- root inode ---
        t16     `cramfs_mode    mode
        u16     1               uid
rsz:    u32     1               size (24 bits) + gid (8 bits)
rno:    u32     1               name length / 4 (6 bits) + offset / 4 (26 bits)
#set    rnl = (rno & 0x3F) << 2
#set    rdir = (rno >> 6) << 2
        c       rnl             name
        :--- root directory entries ---
        .       rdir
#set    dend = rdir + (rsz & 0xFFFFFF)
#repeat while ^@ + 12 <= dend
        t16     `cramfs_mode    mode
        u16     1               uid
        u32     1               size (24 bits) + gid (8 bits)
eno:    u32     1               name length / 4 (6 bits) + offset / 4 (26 bits)
#set    enl = (eno & 0x3F) << 2
        c       enl             name
#end

/`cramfs_flags
0x00000001      fsid version 2
0x00000002      sorted directories
0x00000100      holes
0x00000200      wrong signature
0x00000400      shifted root offset

/`cramfs_mode
0170000 0140000 socket
0170000 0120000 symlink
0170000 0100000 regular file
0170000 0060000 block device
0170000 0040000 directory
0170000 0020000 character device
0170000 0010000 fifo
0004000         setuid
0002000         setgid
0001000         sticky
0000400         owner read
0000200         owner write
0000100         owner exec
0000040         group read
0000020         group write
0000010         group exec
0000004         other read
0000002         other write
0000001         other exec
