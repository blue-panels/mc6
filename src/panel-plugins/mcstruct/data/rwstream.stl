STL 5.00
;
;   RenderWare binary stream (.dff, .txd): chunk headers walked flat,
;   containers entered. After kaitai_struct_formats
;   game/renderware_binary_stream.ksy.
;

/RW_STREAM
#repeat while ^@ + 12 <= $size
        :--- chunk ---
code:   u32     'rw_chunk       type
csz:    u32     1               size
        d       1               library id stamp (version)
#if code == 0x10 || code == 0x0F || code == 0x14 || code == 0x0E || code == 0x1A || code == 0x1B || code == 0x03 || code == 0x06 || code == 0x08 || code == 0x16
        :container, the chunks inside follow
#elseif code == 0x01
        +       csz             struct data
#else
        +       csz
#fi
#end

/'rw_chunk
0x01    struct
0x02    string
0x03    extension
0x05    camera
0x06    texture
0x07    material
0x08    material list
0x0A    frame list
0x0E    atomic
0x0F    geometry
0x10    clump
0x14    geometry list
0x15    texture native
0x16    texture dictionary
0x1A    animation
0x1B    HAnim
0x0253F2FE      bin mesh
0x0253F2FF      native data
0x0253F2FC      material effects
