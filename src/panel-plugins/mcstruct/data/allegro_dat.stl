STL 5.00
;
;   Allegro 4 .dat (unpacked): objects with their properties.
;   After kaitai_struct_formats game/allegro_dat.ksy.
;

/ALLEGRO_DAT
#endian big
        u32     'allegro_pack   pack magic
        c       4               dat magic (ALL.)
n:      u32     1               objects
#repeat n
        :--- object ---
#repeat while @d == "prop"
        c       4               prop
        c       4               property type
plen:   u32     1               length
        c       plen            value
#end
tp:     c       4               type
clen:   i32     1               compressed length
        i32     1               uncompressed length
#if tp == 'BMP '
        i16     1               bits per pixel
        u16     1               width
        u16     1               height
        +       "clen - 6"      image
#elseif tp == 'RLE '
        i16     1               bits per pixel
        u16     1               width
        u16     1               height
        u32     1               image length
        +       "clen - 10"     image
#elseif tp == 'FONT'
        i16     1               font size (8, 16, 0 = ranges)
        +       "clen - 2"      glyphs
#else
        +       clen            body
#fi
#end

/'allegro_pack
0x736C682E      unpacked (slh.)
0x736C682B      packed (slh+)
