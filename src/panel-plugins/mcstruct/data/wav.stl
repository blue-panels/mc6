STL 5.00
;
;   RIFF WAVE: chunks, the fmt chunk in detail
;

/WAV
        c       4               RIFF
        u32     1               file size - 8
        c       4               WAVE
#repeat while ^@ + 8 <= $size
#if @d == 'fmt '
        c       4               chunk id
len:    u32     1               chunk size
        u16     'wav_format     format
        u16     1               channels
        u32     1               sample rate
        u32     1               byte rate
        u16     1               block align
        u16     1               bits per sample
#if len > 16
        +       len - 16
#fi
#else
        c       4               chunk id
len:    u32     1               chunk size
        +       len
#fi
#if len % 2 == 1
        +       1
#fi
#end

/'wav_format
1       PCM
2       ADPCM
3       IEEE float
6       A-law
7       mu-law
0x11    IMA ADPCM
0x55    MP3
0xFFFE  extensible
