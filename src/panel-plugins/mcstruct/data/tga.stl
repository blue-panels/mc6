STL 5.00
;
;   Truevision TGA: header, image id, color map, and the TGA 2.0 footer
;   with the extension area. After kaitai_struct_formats image/tga.ksy.
;

/TGA
idlen:  u8      1               image id length
cmap:   u8      'tga_cmap       color map type
        u8      'tga_image      image type
        u16     1               color map first entry
ncmap:  u16     1               color map entries
cdepth: u8      1               color map entry bits
        u16     1               x origin
        u16     1               y origin
        u16     1               width
        u16     1               height
        u8      1               pixel depth
        t8      `tga_desc       image descriptor
        c       idlen           image id
#if cmap == 1
        *       ncmap   :tga_color step "(cdepth + 7) / 8" "color map"
#fi
        :--- footer (TGA 2.0) ---
        .       "$size - 26"
extofs: u32     1               extension area offset
        u32     1               developer directory offset
        c       18              signature
#if extofs != 0
        :--- extension area ---
        .       extofs
        u16     1               extension size
        c       41              author name
        c       81              comment line 1
        c       81              comment line 2
        c       81              comment line 3
        c       81              comment line 4
        u16     1               stamp month
        u16     1               stamp day
        u16     1               stamp year
        u16     1               stamp hour
        u16     1               stamp minute
        u16     1               stamp second
        c       41              job name
        u16     1               job hours
        u16     1               job minutes
        u16     1               job seconds
        c       41              software id
        u16     1               software version
        c       1               software version letter
        u32     1               key color
        u32     1               pixel aspect ratio
        u32     1               gamma value
        u32     1               color correction offset
        u32     1               postage stamp offset
        u32     1               scan line offset
        u8      'tga_attr       attributes type
#fi

/:tga_color
b       1       blue
b       1       green
b       1       red
b       1       alpha

/'tga_cmap
0       none
1       present

/'tga_image
0       no image data
1       uncompressed, color mapped
2       uncompressed, true color
3       uncompressed, grayscale
9       RLE, color mapped
10      RLE, true color
11      RLE, grayscale

/`tga_desc
0x0F    0x0F    alpha bits
0x10            right to left
0x20            top to bottom

/'tga_attr
0       no alpha
1       undefined data, ignore
2       undefined data, keep
3       alpha
4       premultiplied alpha
