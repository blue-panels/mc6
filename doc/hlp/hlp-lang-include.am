hlpdir = $(pkgdatadir)/help
# The help is split by program: a node the manual of the file manager does not
# have is looked for in the file of the program it belongs to.  A language
# that has no file of its own for a program falls back to the English one.
hlp_DATA = mcommander.$(HLP_LANG).md $(HLP_DOMAIN_MD)

EXTRA_DIST = xnc.md
CLEANFILES = $(hlp_DATA)

mcommander.$(HLP_LANG).md: $(top_srcdir)/doc/man/$(HLP_LANG)/mcommander.md $(srcdir)/xnc.md
	cat $(top_srcdir)/doc/man/$(HLP_LANG)/mcommander.md $(srcdir)/xnc.md > $@
