    {
      "signature": "mc.ui.screen(spec) -> screen|nil, error?",
      "workspace": "any",
      "capability": "ui",
      "mutation": "yes",
      "errors": [],
      "summary": "Describe a full-screen grid of widgets: a title, a status line on top, keys for the button bar at the bottom, and between them spec.layout, rows of cells; a row is height = n lines or weight = n, a cell is width = n columns or weight = n and holds one control: label, status, text, separator, input, checkbox, or a table with columns and rows(first, count).  help = {file, node}; the callbacks are on_key, on_enter, on_action, on_check, on_row, on_resize, on_close.  screen:run() shows it and returns when it is closed."
    },
